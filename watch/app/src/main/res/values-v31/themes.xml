<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ab Android 12 zeichnet das System einen eigenen Startbildschirm: auch der bleibt schwarz,
         ohne hellen Kreis hinter dem Symbol. -->
    <style name="Theme.RejuvenationBed" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
        <!-- Eigenes Symbol statt des Startersymbols: sonst legt das System einen weißen Kreis dahinter. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_bett</item>
    </style>
</resources>
